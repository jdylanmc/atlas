{
  "name": "@jdylanmc/atlas",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "atlas-sdk:validate": "node scripts/atlas_sdk_agents.ts validate",
    "cacophony:sync": "node scripts/cacophony_agents.ts sync",
    "cacophony:validate": "node scripts/cacophony_agents.ts validate",
    "ci": "npm run format:check && npm run lint && npm run build && npm run typecheck && npm run test:coverage && npm run test:coverage:product && npm run atlas-sdk:validate && npm run sdk-atlas:lint && npm run vocabulary:validate && npm run cacophony:validate && npm run workflow:lint",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" scripts tests .github/workflows docs/ci.md .cacophony/README.md package.json package-lock.json tsconfig.json tsconfig.build.json eslint.config.js prettier.config.js",
    "framework:assemble": "node scripts/framework_bundle.ts assemble --output dist/framework-bundle",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" scripts tests .github/workflows docs/ci.md .cacophony/README.md package.json package-lock.json tsconfig.json tsconfig.build.json eslint.config.js prettier.config.js",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" scripts tests",
    "sdk-atlas:lint": "node scripts/sdk_atlas_lint.ts validate",
    "test:coverage": "c8 --all --include \"scripts/**/*.ts\" --check-coverage --lines 78 --functions 93 --branches 68 --statements 78 node --test tests/*.test.ts",
    "test:coverage:product": "c8 --all --include \"src/**/*.ts\" --check-coverage --100 node --test tests/*.test.ts",
    "test:unit": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "vocabulary:validate": "node scripts/vocabulary_agreement.ts validate",
    "workflow:lint": "node scripts/run_actionlint.ts",
    "build": "node --eval \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -p tsconfig.build.json",
    "package:pack": "npm pack --ignore-scripts=false",
    "package:publish": "npm publish --ignore-scripts=false",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "c8": "12.0.0",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm-footnote": "2.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm-footnote": "2.1.0",
    "yaml": "2.9.0"
  },
  "bin": {
    "atlas": "./dist/scripts/atlas_bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ]
}
