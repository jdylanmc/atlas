{
  "schema": 1,
  "reviewResolutionRule": "A review finding is resolved only after tests/adversarial has a case exercising the governance gate.",
  "cases": [
    {
      "name": "distinct-same-base-governance-intents-use-independent-proposals",
      "gate": "governance",
      "kind": "proposal-concurrency",
      "expectation": "accept",
      "absentCode": "ATLAS_GOVERNANCE_WORKSPACE_EXISTS",
      "concurrentProposals": {
        "first": {
          "changelog": "Created No Model Principle.",
          "id": "no-model",
          "title": "No Model",
          "truth": "Trusted validation runs where a model cannot reach it.",
          "truthId": "no-model"
        },
        "second": {
          "changelog": "Created No Network Principle.",
          "id": "no-network",
          "title": "No Network",
          "truth": "Trusted validation completes without network access.",
          "truthId": "no-network"
        }
      }
    },
    {
      "name": "exact-authored-path-duplicates-are-refused",
      "gate": "governance",
      "kind": "change-path-collision",
      "expectation": "reject",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGE_PATH_COLLISION",
      "contents": ["first authored bytes", "second authored bytes"],
      "paths": [".atlas/principles/path-one.md", ".atlas/principles/path-one.md"]
    },
    {
      "name": "reversed-exact-authored-path-duplicates-are-refused",
      "gate": "governance",
      "kind": "change-path-collision",
      "expectation": "reject",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGE_PATH_COLLISION",
      "contents": ["second authored bytes", "first authored bytes"],
      "paths": [".atlas/principles/path-one.md", ".atlas/principles/path-one.md"]
    },
    {
      "name": "case-folded-authored-path-aliases-are-refused",
      "gate": "governance",
      "kind": "change-path-collision",
      "expectation": "reject",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGE_PATH_COLLISION",
      "paths": [".atlas/principles/path-case.md", ".atlas/PRINCIPLES/PATH-CASE.md"]
    },
    {
      "name": "unicode-normalized-authored-path-aliases-are-refused",
      "gate": "governance",
      "kind": "change-path-collision",
      "expectation": "reject",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGE_PATH_COLLISION",
      "paths": [".atlas/principles/café.md", ".atlas/principles/café.md"]
    },
    {
      "name": "trailing-dot-authored-path-aliases-are-refused",
      "gate": "governance",
      "kind": "change-path-collision",
      "expectation": "reject",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGE_PATH_COLLISION",
      "paths": [".atlas/principles/path-dot.md", ".atlas/principles/path-dot.md."]
    },
    {
      "name": "trailing-space-authored-path-aliases-are-refused",
      "gate": "governance",
      "kind": "change-path-collision",
      "expectation": "reject",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGE_PATH_COLLISION",
      "paths": [".atlas/principles/path-space.md", ".atlas/principles/path-space.md "]
    },
    {
      "name": "distinct-authored-paths-remain-accepted",
      "gate": "governance",
      "kind": "change-path-collision",
      "expectation": "accept",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGE_PATH_COLLISION",
      "paths": [".atlas/principles/path-left.md", ".atlas/principles/path-right.md"]
    },
    {
      "name": "written-content-drift-is-refused-before-commit",
      "gate": "governance",
      "kind": "written-content-mismatch",
      "expectation": "reject",
      "expectedCode": "ATLAS_GOVERNANCE_WRITTEN_CHANGE_SET_MISMATCH"
    },
    {
      "name": "founding-cannot-purge-an-earlier-governance-fragment",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_FOUNDING_GOVERNANCE_REMOVAL_FORBIDDEN",
      "retirement": {
        "atFounding": true,
        "request": {
          "action": "retire",
          "changes": [{ "path": ".atlas/principles/determinism.md", "content": null }]
        }
      }
    },
    {
      "name": "retirement-preserves-an-unexpected-workspace-file",
      "gate": "governance",
      "kind": "retirement-workspace",
      "expectedCode": "ATLAS_GOVERNANCE_RUNTIME_FAILED",
      "workspaceConflict": {
        "kind": "file",
        "content": "Concurrent fixture work must survive.\n"
      }
    },
    {
      "name": "retirement-preserves-an-unexpected-workspace-symlink-and-its-target",
      "gate": "governance",
      "kind": "retirement-workspace",
      "expectedCode": "ATLAS_GOVERNANCE_RUNTIME_FAILED",
      "workspaceConflict": {
        "kind": "symlink",
        "content": "Outside fixture work must survive.\n"
      }
    },
    {
      "name": "retirement-cannot-remove-a-non-governance-document",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_GOVERNANCE_RETIREMENT_TARGET_INVALID",
      "retirement": {
        "request": {
          "action": "retire",
          "changes": [{ "path": ".atlas/index.md", "content": null }]
        }
      }
    },
    {
      "name": "retirement-cannot-remove-a-missing-document",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_GOVERNANCE_RETIREMENT_TARGET_INVALID",
      "retirement": {
        "request": {
          "action": "retire",
          "changes": [{ "path": ".atlas/principles/missing.md", "content": null }]
        }
      }
    },
    {
      "name": "retirement-cannot-purge-a-wrong-subject",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_GOVERNANCE_RETIREMENT_TARGET_INVALID",
      "retirement": {
        "request": {
          "action": "retire",
          "subject": "atlas-policy",
          "changes": [{ "path": ".atlas/principles/retirement.md", "content": null }]
        }
      }
    },
    {
      "name": "retirement-requires-a-parsed-governance-document",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_GOVERNANCE_RETIREMENT_TARGET_INVALID",
      "retirement": {
        "target": "malformed",
        "request": {
          "action": "retire",
          "changes": [{ "path": ".atlas/principles/retirement.md", "content": null }]
        }
      }
    },
    {
      "name": "retirement-checks-the-document-type-not-just-its-directory",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_GOVERNANCE_RETIREMENT_TARGET_INVALID",
      "retirement": {
        "target": "wrong-type",
        "request": {
          "action": "retire",
          "changes": [{ "path": ".atlas/principles/retirement.md", "content": null }]
        }
      }
    },
    {
      "name": "amend-cannot-smuggle-a-file-removal",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_GOVERNANCE_REMOVAL_ACTION_REQUIRED",
      "retirement": {
        "request": {
          "action": "amend",
          "changes": [{ "path": ".atlas/principles/retirement.md", "content": null }]
        }
      }
    },
    {
      "name": "retirement-does-not-retain-empty-tombstones",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_GOVERNANCE_RETIREMENT_REMOVAL_REQUIRED",
      "retirement": {
        "request": {
          "action": "retire",
          "changes": [{ "path": ".atlas/principles/retirement.md", "content": "" }]
        }
      }
    },
    {
      "name": "retirement-does-not-supply-human-approval",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_GOVERNANCE_APPROVAL_REQUIRED",
      "retirement": {
        "unapproved": true,
        "request": {
          "action": "retire",
          "changes": [{ "path": ".atlas/principles/retirement.md", "content": null }]
        }
      }
    },
    {
      "name": "retirement-requires-a-reason",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGELOG_REQUIRED",
      "retirement": {
        "request": {
          "action": "retire",
          "changelog": "",
          "changes": [{ "path": ".atlas/principles/retirement.md", "content": null }]
        }
      }
    },
    {
      "name": "retirement-cannot-purge-its-audit-trail",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGELOG_RESERVED",
      "retirement": {
        "request": {
          "action": "delete",
          "changes": [{ "path": ".atlas/CHANGELOG.md", "content": null }]
        }
      }
    },
    {
      "name": "retirement-refuses-a-line-separator-in-provenance",
      "gate": "governance",
      "kind": "retirement",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGELOG_MALFORMED",
      "retirement": {
        "approver": "Fixture\u2028## 2099-01-01",
        "request": {
          "action": "retire",
          "changes": [{ "path": ".atlas/principles/retirement.md", "content": null }]
        }
      }
    },
    {
      "name": "caller-range-mutation-cannot-retarget-trusted-refusals",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_GOVERNANCE_TRUSTED_FINDING_OVERRIDE_REJECTED",
      "merge": {
        "trusted": ["trustedFirst", "trustedSecond"],
        "supplied": ["hostileFirst", "hostileSecond"],
        "expected": [
          "rejectedFirst",
          "rejectedSecond",
          "trustedFirst",
          "trustedSecond"
        ],
        "mutateSuppliedLocations": true
      }
    },
    {
      "name": "repeated-request-observations-coalesce",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGE_SET_PATH_INVALID",
      "assembly": "request",
      "expectedCodes": [
        "ATLAS_GOVERNANCE_CHANGE_PATH_COLLISION",
        "ATLAS_GOVERNANCE_CHANGE_SET_PATH_INVALID"
      ]
    },
    {
      "name": "repeated-fragment-observations-coalesce",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_PRINCIPLE_IDENTITY_CHANGED",
      "assembly": "fragment",
      "expectedCodes": [
        "ATLAS_GOVERNANCE_CHANGE_PATH_COLLISION",
        "ATLAS_GOVERNANCE_PRINCIPLE_AMENDMENT_REQUIRED",
        "ATLAS_GOVERNANCE_PRINCIPLE_IDENTITY_CHANGED"
      ]
    },
    {
      "name": "repeated-workflow-observations-coalesce",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_PRINCIPLE_IDENTITY_CHANGED",
      "assembly": "workflow",
      "expectedCodes": [
        "ATLAS_GOVERNANCE_CHANGE_PATH_COLLISION",
        "ATLAS_GOVERNANCE_PRINCIPLE_AMENDMENT_REQUIRED",
        "ATLAS_GOVERNANCE_PRINCIPLE_IDENTITY_CHANGED"
      ]
    },
    {
      "name": "duplicate-trusted-findings-coalesce",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trusted", "trusted"],
        "supplied": [],
        "expected": ["trusted"]
      }
    },
    {
      "name": "duplicate-supplied-findings-coalesce",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": { "trusted": [], "supplied": ["owned", "owned"], "expected": ["owned"] }
    },
    {
      "name": "trusted-attribution-wins-the-same-identity",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trusted"],
        "supplied": ["owned"],
        "expected": ["trusted"]
      }
    },
    {
      "name": "later-trusted-attribution-replaces-an-untrusted-duplicate",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["owned", "trusted"],
        "supplied": [],
        "expected": ["trusted"]
      }
    },
    {
      "name": "untrusted-severity-cannot-replace-a-trusted-identity",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trustedWarning"],
        "supplied": ["owned"],
        "expected": ["trustedWarning"]
      }
    },
    {
      "name": "a-distinct-location-is-not-a-trusted-downgrade",
