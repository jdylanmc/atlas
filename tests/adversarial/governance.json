{
  "schema": 1,
  "reviewResolutionRule": "A review finding is resolved only after tests/adversarial has a case exercising the governance gate.",
  "cases": [
    {
      "name": "repeated-request-observations-coalesce",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGE_SET_PATH_INVALID",
      "assembly": "request",
      "expectedCodes": ["ATLAS_GOVERNANCE_CHANGE_SET_PATH_INVALID"]
    },
    {
      "name": "repeated-fragment-observations-coalesce",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_PRINCIPLE_IDENTITY_CHANGED",
      "assembly": "fragment",
      "expectedCodes": [
        "ATLAS_GOVERNANCE_PRINCIPLE_AMENDMENT_REQUIRED",
        "ATLAS_GOVERNANCE_PRINCIPLE_IDENTITY_CHANGED"
      ]
    },
    {
      "name": "repeated-workflow-observations-coalesce",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_PRINCIPLE_IDENTITY_CHANGED",
      "assembly": "workflow",
      "expectedCodes": [
        "ATLAS_GOVERNANCE_PRINCIPLE_AMENDMENT_REQUIRED",
        "ATLAS_GOVERNANCE_PRINCIPLE_IDENTITY_CHANGED"
      ]
    },
    {
      "name": "duplicate-trusted-findings-coalesce",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trusted", "trusted"],
        "supplied": [],
        "expected": ["trusted"]
      }
    },
    {
      "name": "duplicate-supplied-findings-coalesce",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": { "trusted": [], "supplied": ["owned", "owned"], "expected": ["owned"] }
    },
    {
      "name": "trusted-attribution-wins-the-same-identity",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trusted"],
        "supplied": ["owned"],
        "expected": ["trusted"]
      }
    },
    {
      "name": "later-trusted-attribution-replaces-an-untrusted-duplicate",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["owned", "trusted"],
        "supplied": [],
        "expected": ["trusted"]
      }
    },
    {
      "name": "untrusted-severity-cannot-replace-a-trusted-identity",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trustedWarning"],
        "supplied": ["owned"],
        "expected": ["trustedWarning"]
      }
    },
    {
      "name": "a-distinct-location-is-not-a-trusted-downgrade",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trustedFirst"],
        "supplied": ["ownedSecond"],
        "expected": ["trustedFirst", "ownedSecond"]
      }
    },
    {
      "name": "repeated-downgrades-produce-one-located-refusal",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trustedFirst"],
        "supplied": ["hostileFirst", "hostileFirst"],
        "expected": ["rejectedFirst", "trustedFirst"]
      }
    },
    {
      "name": "the-complete-source-range-is-part-of-identity",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trustedFirst", "trustedLonger", "trustedSecond"],
        "supplied": [],
        "expected": ["trustedFirst", "trustedLonger", "trustedSecond"]
      }
    },
    {
      "name": "different-paths-remain-distinct",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trusted", "otherPath"],
        "supplied": [],
        "expected": ["otherPath", "trusted"]
      }
    },
    {
      "name": "different-codes-remain-distinct",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["otherCode", "trusted"],
        "supplied": [],
        "expected": ["trusted", "otherCode"]
      }
    },
    {
      "name": "coalescing-never-downgrades-equal-trust",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trustedWarning", "trusted"],
        "supplied": [],
        "expected": ["trusted"]
      }
    },
    {
      "name": "an-absent-location-is-not-a-specified-range",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_PAGE_ID_DUPLICATE",
      "merge": {
        "trusted": ["trusted", "trustedFirst"],
        "supplied": [],
        "expected": ["trusted", "trustedFirst"]
      }
    },
    {
      "name": "semantic-verdict-without-evidence-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_SEMANTIC_EVIDENCE_REQUIRED"
    },
    {
      "name": "semantic-verdict-challenge-disagreement-escalates",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_SEMANTIC_DISAGREEMENT"
    },
    {
      "name": "hostile-finding-downgrade-is-rejected",
      "gate": "governance",
      "kind": "finding-merge",
      "expectedCode": "ATLAS_GOVERNANCE_TRUSTED_FINDING_OVERRIDE_REJECTED"
    },
    {
      "name": "principle-amendment-identity-drift-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_PRINCIPLE_IDENTITY_CHANGED"
    },
    {
      "name": "principle-truth-replacement-without-successor-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_PRINCIPLE_TRUTH_SUCCESSOR_REQUIRED"
    },
    {
      "name": "policy-without-scope-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_POLICY_SCOPE_REQUIRED"
    },
    {
      "name": "policy-without-evaluation-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_POLICY_EVALUATION_REQUIRED"
    },
    {
      "name": "policy-without-consequence-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_POLICY_CONSEQUENCE_REQUIRED"
    },
    {
      "name": "policy-governing-explore-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_POLICY_EXPLORE_FORBIDDEN"
    },
    {
      "name": "semantic-verdict-for-unrelated-policy-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_POLICY_VERDICT_MISSING"
    },
    {
      "name": "policy-page-identity-drift-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_POLICY_IDENTITY_CHANGED"
    },
    {
      "name": "failing-semantic-verdict-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_SEMANTIC_VERDICT_FAILED"
    },
    {
      "name": "crafted-resume-receipts-are-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_RESUME_CHANGE_SET_MISMATCH"
    },
    {
      "name": "amend-that-empties-active-truths-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_PRINCIPLE_TRUTH_REQUIRED"
    },
    {
      "name": "policy-mutation-without-any-verdict-is-rejected",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_POLICY_EVALUATION_UNSUPPORTED"
    },
    {
      "name": "caller-authored-changelog-path-is-reserved-to-the-sdk",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGELOG_RESERVED"
    },
    {
      "name": "case-folded-changelog-path-collision-is-reserved",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGELOG_RESERVED"
    },
    {
      "name": "changelog-prose-newline-injection-is-refused",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_CHANGELOG_MALFORMED"
    },
    {
      "name": "concurrent-atlas-head-advancement-is-refused",
      "gate": "governance",
      "kind": "semantic",
      "expectedCode": "ATLAS_GOVERNANCE_BASE_SNAPSHOT_STALE"
    }
  ]
}
