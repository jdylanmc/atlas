{
  "schema": 1,
  "reviewResolutionRule": "A review finding is resolved only after this corpus has a reject or accept case that exercises it.",
  "cases": [
    {
      "name": "reject an Ingest operation that reaches for the network or a model",
      "gate": "atlas-cli",
      "kind": "source-boundary",
      "path": "src/operations/ingest_operation.ts",
      "forbiddenImports": [
        "node:http",
        "node:https",
        "node:net",
        "node:tls",
        "node:dgram",
        "node:child_process",
        "child_process",
        "undici",
        "openai",
        "anthropic",
        "fetch("
      ]
    },
    {
      "name": "reject non-completed payload carrying an Atlas verdict",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": ["lint", "--machine", "--bogus"],
      "expectedExit": 64,
      "expectedCode": "ATLAS_LINT_USAGE",
      "forbidPayloadLint": true
    },
    {
      "name": "reject retired repository flag",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "lint",
        "--machine",
        "--repository",
        "tests/fixtures/complete-atlas"
      ],
      "expectedExit": 64,
      "expectedCode": "ATLAS_LINT_USAGE",
      "stderrIncludes": "--atlas-host-directory"
    },
    {
      "name": "reject duplicate Atlas Host Directory flags before linting the last Atlas",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "lint",
        "--machine",
        "--atlas-host-directory",
        "tests/fixtures/invalid-complete-atlas",
        "--atlas-host-directory",
        "tests/fixtures/complete-atlas"
      ],
      "expectedExit": 64,
      "expectedCode": "ATLAS_LINT_USAGE",
      "forbidPayloadLint": true
    },
    {
      "name": "reject missing Atlas as retryable runtime failure",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "lint",
        "--machine",
        "--atlas-host-directory",
        "tests/fixtures/no-such-atlas"
      ],
      "expectedExit": 64,
      "expectedCode": "ATLAS_LINT_ATLAS_NOT_FOUND",
      "expectedDegradationState": "not-degraded",
      "recommendedNextActionExcludes": "Retry"
    },
    {
      "name": "reject command script bypassing the interface layer",
      "gate": "atlas-cli",
      "kind": "source-boundary",
      "path": "scripts/atlas.ts",
      "forbiddenImports": [
        "../src/atlas/",
        "../src/operations/",
        "../src/domain/",
        "../src/lint/"
      ]
    },
    {
      "name": "reject Atlas View snapshot input carrying pages and validity separately",
      "gate": "atlas-cli",
      "kind": "source-contract",
      "path": "src/atlas/atlas_view.ts",
      "requiredText": "readonly validation: AtlasInputValidation;",
      "forbiddenText": "export interface AtlasViewSnapshotInput {\n  readonly files:"
    },
    {
      "name": "accept Atlas View post-construction input mutation without digest drift",
      "gate": "atlas-cli",
      "kind": "atlas-view-mutation",
      "expectedSlug": "before-slug",
      "mutatedSlug": "after-slug",
      "expectedSnapshot": "before-sha",
      "mutatedSnapshot": "after-sha"
    },
    {
      "name": "reject Explore reparsing pages instead of consuming Atlas View",
      "gate": "atlas-cli",
      "kind": "source-boundary",
      "path": "src/graph/explore_atlas.ts",
      "forbiddenImports": ["parse_atlas_pages"]
    },
    {
      "name": "reject Explore truncating wrapped governing truths",
      "gate": "atlas-cli",
      "kind": "source-contract",
      "path": "src/graph/explore_atlas.ts",
      "requiredText": "textParts.join(\" \")",
      "forbiddenText": "text: match[2] as string"
    },
    {
      "name": "reject an Explore Atlas exceeding the file-count budget before file reads",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "explore",
        "--machine",
        "anything",
        "--atlas-host-directory",
        "{atlasHostDirectory}"
      ],
      "generatedExploreAtlasOverFileBudget": true,
      "expectedExit": 64,
      "expectedCode": "ATLAS_EXPLORE_ATLAS_TOO_MANY_FILES"
    },
    {
      "name": "reject an Explore command with invalid arguments as machine JSON",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": ["explore", "--machine", "first", "second"],
      "expectedExit": 64,
      "expectedCode": "ATLAS_EXPLORE_USAGE",
      "stderrIncludes": "usage: atlas explore"
    },
    {
      "name": "reject an Explore command whose Atlas Host Directory is missing",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "explore",
        "--machine",
        "anything",
        "--atlas-host-directory",
        "tests/fixtures/no-such-atlas"
      ],
      "expectedExit": 64,
      "expectedCode": "ATLAS_EXPLORE_ATLAS_NOT_FOUND",
      "expectedDegradationState": "not-degraded"
    },
    {
      "name": "reject an oversized Explore request before traversal",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "explore",
        "--machine",
        "{oversizedExploreQuery}",
        "--atlas-host-directory",
        "tests/fixtures/complete-atlas"
      ],
      "generatedOversizedExploreQuery": true,
      "expectedExit": 64,
      "expectedCode": "ATLAS_EXPLORE_QUERY_TOO_LARGE"
    },
    {
      "name": "reject an Explore command seam that reaches for the network or a model",
      "gate": "atlas-cli",
      "kind": "source-boundary",
      "path": "src/interfaces/explore_command.ts",
      "forbiddenImports": [
        "node:http",
        "node:https",
        "node:net",
        "node:tls",
        "node:dgram",
        "node:child_process",
        "child_process",
        "undici",
        "openai",
        "anthropic",
        "fetch("
      ]
    },
    {
      "name": "reject an Explore platform adapter that can write Atlas state",
      "gate": "atlas-cli",
      "kind": "source-boundary",
      "path": "src/platform/local_atlas_explore.ts",
      "forbiddenImports": [
        "appendFileSync",
        "mkdirSync",
        "renameSync",
        "writeFileSync",
        "runTrustedGitForWrite"
      ]
    },
    {
      "name": "reject total byte budget before reading the offending file",
      "gate": "atlas-cli",
      "kind": "capture-budget",
      "files": [
        {
          "path": ".atlas/a.md",
          "text": "aaaaaaaaaa"
        },
        {
          "path": ".atlas/b.md",
          "text": "bbbbbbbbbb"
        }
      ],
      "budgets": {
        "maxFileBytes": 10,
        "maxFiles": 10,
        "maxTotalBytes": 15,
        "maxTraversalDepth": 4
      },
      "maxBytesRead": 10,
      "expectedCode": "ATLAS_LOAD_TOTAL_TOO_LARGE"
    },
    {
      "name": "reject an Ingest command seam that reaches for the network or a model",
      "gate": "atlas-cli",
      "kind": "source-boundary",
      "path": "src/interfaces/ingest_command.ts",
      "forbiddenImports": [
        "node:http",
        "node:https",
        "node:net",
        "node:tls",
        "node:dgram",
        "node:child_process",
        "child_process",
        "undici",
        "openai",
        "anthropic",
        "fetch("
      ]
    },
    {
      "name": "reject an Ingest platform adapter that reaches for the network or a model",
      "gate": "atlas-cli",
      "kind": "source-boundary",
      "path": "src/platform/local_atlas_ingest.ts",
      "forbiddenImports": [
        "node:http",
        "node:https",
        "node:net",
        "node:tls",
        "node:dgram",
        "undici",
        "openai",
        "anthropic",
        "fetch("
      ]
    },
    {
      "name": "reject an Ingest plan that hands out a Crawl Assignment without approval",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "plan",
        "--machine",
        "--ingest-scope",
        "tests/fixtures/ingest/scope-unapproved.json"
      ],
      "expectedExit": 4,
      "expectedCode": "ATLAS_INGEST_APPROVAL_REQUIRED",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest plan whose approval time is not a date-time",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "plan",
        "--machine",
        "--ingest-scope",
        "tests/fixtures/ingest/scope-bad-approved-at.json"
      ],
      "expectedExit": 4,
      "expectedCode": "ATLAS_INGEST_APPROVAL_REQUIRED",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest plan whose approval time is date-only",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "plan",
        "--machine",
        "--ingest-scope",
        "tests/fixtures/ingest/scope-date-only-approved-at.json"
      ],
      "expectedExit": 4,
      "expectedCode": "ATLAS_INGEST_APPROVAL_REQUIRED",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest plan whose Ingest Scope asOf is date-only",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "plan",
        "--machine",
        "--ingest-scope",
        "tests/fixtures/ingest/scope-date-only-asof.json"
      ],
      "expectedExit": 1,
      "expectedCode": "ATLAS_INGEST_SCOPE_AS_OF_INVALID",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest reconcile whose Ingest Scope asOf is not a date-time",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "reconcile",
        "--machine",
        "--ingest-request",
        "tests/fixtures/ingest/request-bad-asof.json",
        "--atlas-host-directory",
        "{atlasHostDirectory}"
      ],
      "fixtureAtlasHostRepository": true,
      "expectedExit": 1,
      "expectedCode": "ATLAS_INGEST_SCOPE_AS_OF_INVALID",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest reconcile whose Ingest Scope asOf is date-only",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "reconcile",
        "--machine",
        "--ingest-request",
        "tests/fixtures/ingest/request-date-only-asof.json",
        "--atlas-host-directory",
        "{atlasHostDirectory}"
      ],
      "fixtureAtlasHostRepository": true,
      "expectedExit": 1,
      "expectedCode": "ATLAS_INGEST_SCOPE_AS_OF_INVALID",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest plan whose approval time is an uncomparable leap second",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "plan",
        "--machine",
        "--ingest-scope",
        "tests/fixtures/ingest/scope-leap-second-approved-at.json"
      ],
      "expectedExit": 4,
      "expectedCode": "ATLAS_INGEST_APPROVAL_REQUIRED",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest plan whose Ingest Scope asOf is an uncomparable leap second",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "plan",
        "--machine",
        "--ingest-scope",
        "tests/fixtures/ingest/scope-leap-second-asof.json"
      ],
      "expectedExit": 1,
      "expectedCode": "ATLAS_INGEST_SCOPE_AS_OF_INVALID",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest reconcile whose Ingest Scope asOf is an uncomparable leap second",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "reconcile",
        "--machine",
        "--ingest-request",
        "tests/fixtures/ingest/request-leap-second-asof.json",
        "--atlas-host-directory",
        "{atlasHostDirectory}"
      ],
      "fixtureAtlasHostRepository": true,
      "expectedExit": 1,
      "expectedCode": "ATLAS_INGEST_SCOPE_AS_OF_INVALID",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest reconcile whose Source Revision Time is an uncomparable leap second",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "reconcile",
        "--machine",
        "--ingest-request",
        "tests/fixtures/ingest/request-leap-second-revision-time.json",
        "--atlas-host-directory",
        "{atlasHostDirectory}"
      ],
      "fixtureAtlasHostRepository": true,
      "expectedExit": 1,
      "expectedCode": "ATLAS_INGEST_SOURCE_REVISION_TIME_INVALID",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest reconcile whose Source Revision Time is not a date-time",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "reconcile",
        "--machine",
        "--ingest-request",
        "tests/fixtures/ingest/request-bad-revision-time.json",
        "--atlas-host-directory",
        "{atlasHostDirectory}"
      ],
      "fixtureAtlasHostRepository": true,
      "expectedExit": 1,
      "expectedCode": "ATLAS_INGEST_SOURCE_REVISION_TIME_INVALID",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest reconcile whose Source Revision Time is date-only",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "reconcile",
        "--machine",
        "--ingest-request",
        "tests/fixtures/ingest/request-date-only-revision-time.json",
        "--atlas-host-directory",
        "{atlasHostDirectory}"
      ],
      "fixtureAtlasHostRepository": true,
      "expectedExit": 1,
      "expectedCode": "ATLAS_INGEST_SOURCE_REVISION_TIME_INVALID",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an oversized Ingest request before reading JSON",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "reconcile",
        "--machine",
        "--ingest-request",
        "{oversizedIngestRequest}",
        "--atlas-host-directory",
        "tests/fixtures/complete-atlas"
      ],
      "generatedOversizedIngestRequest": true,
      "expectedExit": 64,
      "expectedCode": "ATLAS_INGEST_INPUT_TOO_LARGE",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest reconcile whose Candidate Graph omits the approved Source",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "reconcile",
        "--machine",
        "--ingest-request",
        "tests/fixtures/ingest/request-wrong-source.json",
        "--atlas-host-directory",
        "tests/fixtures/complete-atlas"
      ],
      "expectedExit": 1,
      "expectedCode": "ATLAS_INGEST_SOURCE_CORRESPONDENCE",
      "forbidPayloadLint": true
    },
    {
      "name": "reject collapsing Ingest scope-expansion pauses into operation failures",
      "gate": "atlas-cli",
      "kind": "source-contract",
      "path": "src/interfaces/ingest_command.ts",
      "requiredText": "result.handoff.unresolvedHumanDecisions.state === \"pending\"",
      "forbiddenText": "return ingestCommandExitCodes.operationFailed;\n  if (result.handoff.unresolvedHumanDecisions.state === \"pending\")"
    },
    {
      "name": "reject an Ingest reconcile input that does not type-check",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": [
        "ingest",
        "reconcile",
        "--machine",
        "--ingest-request",
        "tests/fixtures/ingest/request-malformed.json"
      ],
      "expectedExit": 64,
      "expectedCode": "ATLAS_INGEST_INPUT_INVALID",
      "forbidPayloadLint": true
    },
    {
      "name": "reject an Ingest command with no subcommand as machine JSON usage",
      "gate": "atlas-cli",
      "kind": "command",
      "arguments": ["ingest", "--machine"],
      "expectedExit": 64,
      "expectedCode": "ATLAS_INGEST_USAGE",
      "stderrIncludes": "usage: atlas ingest",
      "forbidPayloadLint": true
    }
  ]
}
